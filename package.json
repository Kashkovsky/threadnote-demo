{
  "name": "threadnote-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A small, runnable retry example for demonstrating Threadnote's shared engineering memory.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.12.0 || >=26.0.0"
  },
  "scripts": {
    "demo": "node src/demo.ts safe",
    "demo:unsafe": "node src/demo.ts unsafe",
    "demo:compare": "node src/demo.ts compare",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "fast-check": "4.9.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
